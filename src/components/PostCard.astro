---
import { getLocaleFromUrl } from '~/utils/i18n';

interface Props {
  slug: string;
  title: string;
  description: string;
  pubDate: Date;
  tags: string[];
  readingTime: number;
}

const { slug, title, description, pubDate, tags, readingTime } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);
const pathPrefix = locale === 'en' ? '/en' : '';

const dateFormatter = new Intl.DateTimeFormat(locale === 'zh' ? 'zh-CN' : 'en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<article class="card group">
  <a href={`${pathPrefix}/blog/${slug}`} class="block">
    <div class="mb-3 flex items-center gap-2 text-xs text-ink-500">
      <time datetime={pubDate.toISOString()}>{dateFormatter.format(pubDate)}</time>
      <span>·</span>
      <span>{readingTime} min</span>
    </div>

    <h3 class="mb-2 text-xl font-semibold text-ink-950 transition-colors group-hover:text-accent">
      {title}
    </h3>

    <p class="mb-4 line-clamp-2 text-sm leading-relaxed text-ink-600">
      {description}
    </p>

    {
      tags.length > 0 && (
        <div class="flex flex-wrap gap-1.5">
          {tags.slice(0, 3).map((tag) => (
            <span class="tag-chip text-[11px]">#{tag}</span>
          ))}
        </div>
      )
    }
  </a>
</article>
