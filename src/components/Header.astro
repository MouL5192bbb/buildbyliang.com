---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { t, type Locale } from '~/utils/i18n';

interface Props {
  locale: Locale;
  otherLocale: Locale;
  otherLocalePath: string;
}

const { locale, otherLocale, otherLocalePath } = Astro.props;
const pathPrefix = locale === 'en' ? '/en' : '';
const navItems = [
  { href: `${pathPrefix}/`, label: t(locale, 'nav.home') },
  { href: `${pathPrefix}/blog`, label: t(locale, 'nav.blog') },
  { href: `${pathPrefix}/projects`, label: t(locale, 'nav.projects') },
  { href: `${pathPrefix}/about`, label: t(locale, 'nav.about') },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="sticky top-0 z-50 border-b border-ink-200 bg-white/80 backdrop-blur-md">
  <div class="mx-auto max-w-5xl px-4 sm:px-6">
    <nav class="flex h-16 items-center justify-between">
      <!-- Logo -->
      <a href={pathPrefix || '/'} class="group flex items-center gap-2">
        <div
          class="flex h-7 w-7 items-center justify-center rounded-md bg-ink-950 transition-colors duration-200 group-hover:bg-accent"
        >
          <span class="text-sm font-bold text-white transition-colors group-hover:text-ink-950"
            >L</span
          >
        </div>
        <span class="font-semibold text-ink-950">buildbyliang</span>
      </a>

      <!-- 导航菜单 -->
      <div class="flex items-center gap-1 sm:gap-2">
        {
          navItems.map((item) => {
            const isActive =
              currentPath === item.href ||
              (item.href !== pathPrefix && item.href !== '/' && currentPath.startsWith(item.href));
            return (
              <a
                href={item.href}
                class:list={[
                  'rounded-md px-3 py-2 text-sm font-medium transition-colors',
                  isActive ? 'text-accent' : 'text-ink-600 hover:bg-ink-100 hover:text-ink-950',
                ]}
                aria-current={isActive ? 'page' : undefined}
              >
                {item.label}
              </a>
            );
          })
        }

        <!-- 语言切换 -->
        <LanguageSwitcher
          currentLocale={locale}
          otherLocale={otherLocale}
          otherLocalePath={otherLocalePath}
        />
      </div>
    </nav>
  </div>
</header>
