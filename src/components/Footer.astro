---
import { t, type Locale } from '~/utils/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-ink-200">
  <div class="mx-auto max-w-5xl px-4 py-8 sm:px-6">
    <div class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-center">
      <div class="text-sm text-ink-500">
        © {year} Liang · {t(locale, 'footer.rights')}
      </div>
      <div class="flex items-center gap-6 text-sm text-ink-500">
        <a
          href="https://github.com/MouL5192bbb"
          target="_blank"
          rel="noopener noreferrer"
          class="transition-colors hover:text-accent"
        >
          GitHub
        </a>
        <a
          href={locale === 'en' ? '/en/rss.xml' : '/rss.xml'}
          class="transition-colors hover:text-accent"
        >
          RSS
        </a>
        <span class="text-ink-400">{t(locale, 'footer.built_with')}</span>
      </div>
    </div>
  </div>
</footer>
