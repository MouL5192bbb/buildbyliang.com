---
import type { Locale } from '~/utils/i18n';

interface Props {
  currentLocale: Locale;
  otherLocale: Locale;
  otherLocalePath: string;
}

const { currentLocale, otherLocale, otherLocalePath } = Astro.props;
const label = currentLocale === 'zh' ? 'EN' : '中';
---

<a
  href={otherLocalePath}
  class="ml-1 rounded-md px-3 py-2 text-sm font-medium text-ink-500 transition-colors hover:bg-ink-100 hover:text-ink-950 sm:ml-2"
  aria-label={`Switch to ${otherLocale === 'zh' ? 'Chinese' : 'English'}`}
  title={otherLocale === 'zh' ? '切换到中文' : 'Switch to English'}
>
  {label}
</a>
