---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PostCard from '~/components/PostCard.astro';
import TagList from '~/components/TagList.astro';
import { getCollection } from 'astro:content';
import readingTime from 'reading-time';
import { t } from '~/utils/i18n';
import { getPostSlug } from '~/utils/posts';

// 获取中文博客
const posts = (
  await getCollection('blog', ({ data }) => {
    return data.locale === 'zh' && !data.draft;
  })
).sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

// 计算标签和文章数
const tagCounts = new Map<string, number>();
posts.forEach((post) => {
  post.data.tags.forEach((tag) => {
    tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
  });
});
const tags = Array.from(tagCounts.entries())
  .map(([name, count]) => ({ name, count }))
  .sort((a, b) => b.count - a.count);
---

<BaseLayout title={t('zh', 'blog.title')} description={t('zh', 'blog.description')}>
  <section class="mx-auto max-w-5xl px-4 py-12 sm:px-6 md:py-16">
    <header class="mb-12">
      <h1 class="mb-4 text-4xl font-bold tracking-tight md:text-5xl">
        {t('zh', 'blog.title')}
      </h1>
      <p class="mb-8 max-w-2xl text-lg leading-relaxed text-ink-600">
        {t('zh', 'blog.description')}
      </p>

      {
        tags.length > 0 && (
          <div class="border-t border-ink-200 pt-6">
            <TagList tags={tags} locale="zh" />
          </div>
        )
      }
    </header>

    {
      posts.length === 0 ? (
        <div class="rounded-xl border border-dashed border-ink-300 p-16 text-center">
          <p class="text-lg text-ink-500">{t('zh', 'blog.no_posts')}</p>
          <p class="mt-2 text-sm text-ink-400">第一篇文章正在准备中...</p>
        </div>
      ) : (
        <div class="grid gap-4 md:grid-cols-2">
          {posts.map((post) => (
            <PostCard
              slug={getPostSlug(post.id, post.data)}
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              tags={post.data.tags}
              readingTime={Math.max(1, Math.round(readingTime(post.body || '').minutes))}
            />
          ))}
        </div>
      )
    }
  </section>
</BaseLayout>
