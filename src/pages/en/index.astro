---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PostCard from '~/components/PostCard.astro';
import { getCollection } from 'astro:content';
import readingTime from 'reading-time';
import { t } from '~/utils/i18n';
import { getPostSlug } from '~/utils/posts';

const posts = (
  await getCollection('blog', ({ data }) => {
    return data.locale === 'en' && !data.draft;
  })
)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 5);

const recentPosts = posts.map((post) => ({
  slug: getPostSlug(post.id, post.data),
  title: post.data.title,
  description: post.data.description,
  pubDate: post.data.pubDate,
  tags: post.data.tags,
  readingTime: Math.max(1, Math.round(readingTime(post.body || '').minutes)),
}));
---

<BaseLayout title={t('en', 'site.title')} description={t('en', 'site.description')}>
  <section class="mx-auto max-w-5xl px-4 pb-16 pt-20 sm:px-6 md:pb-20 md:pt-28">
    <div class="max-w-3xl">
      <div
        class="mb-6 inline-flex items-center gap-2 rounded-full bg-ink-100 px-3 py-1 text-xs font-medium text-ink-700"
      >
        <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-accent"></span>
        {t('en', 'site.tagline')}
      </div>

      <h1 class="mb-6 text-5xl font-bold tracking-tight text-ink-950 md:text-6xl">
        {t('en', 'home.greeting')}
      </h1>

      <p class="mb-8 max-w-2xl text-lg leading-relaxed text-ink-600 md:text-xl">
        {t('en', 'home.intro')}
      </p>

      <div class="flex flex-wrap gap-3">
        <a href="/en/blog" class="btn-primary">
          {t('en', 'home.cta_blog')} →
        </a>
        <a href="/en/projects" class="btn-secondary">
          {t('en', 'home.cta_projects')}
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-5xl border-t border-ink-200 px-4 py-16 sm:px-6">
    <div class="mb-8 flex items-center justify-between">
      <h2 class="text-2xl font-semibold tracking-tight">{t('en', 'home.latest_posts')}</h2>
      <a href="/en/blog" class="text-sm text-ink-600 transition-colors hover:text-accent">
        {t('en', 'home.view_all')}
      </a>
    </div>

    {
      recentPosts.length === 0 ? (
        <div class="rounded-xl border border-dashed border-ink-300 p-12 text-center">
          <p class="text-ink-500">{t('en', 'blog.no_posts')}</p>
          <p class="mt-2 text-sm text-ink-400">First post coming soon...</p>
        </div>
      ) : (
        <div class="grid gap-4 md:grid-cols-2">
          {recentPosts.map((post) => (
            <PostCard
              slug={post.slug}
              title={post.title}
              description={post.description}
              pubDate={post.pubDate}
              tags={post.tags}
              readingTime={post.readingTime}
            />
          ))}
        </div>
      )
    }
  </section>
</BaseLayout>
