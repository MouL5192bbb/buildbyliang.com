---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { t } from '~/utils/i18n';
import { currentFocus, techStack, aiTools, aiToolsNote, contacts, philosophy } from '~/data/about';

const locale = 'en' as const;
---

<BaseLayout title={t(locale, 'about.title')} description={t(locale, 'about.intro')}>
  <article class="prose-container py-12 md:py-16">
    <header class="mb-12">
      <h1 class="mb-4 text-4xl font-bold tracking-tight md:text-5xl">
        {t(locale, 'about.title')}
      </h1>
      <p class="text-lg leading-relaxed text-ink-600">
        {t(locale, 'about.intro')}
      </p>
    </header>

    <section class="mb-12">
      <h2 class="mb-6 flex items-center gap-2 text-2xl font-semibold">
        <span class="h-6 w-1 rounded bg-accent"></span>
        {t(locale, 'about.current_focus')}
      </h2>
      <div class="grid gap-4 sm:grid-cols-2">
        {
          currentFocus.map((item) => (
            <div class="card flex items-center gap-3">
              <span class="text-2xl">{item.icon}</span>
              <span class="font-medium">{item.label[locale]}</span>
            </div>
          ))
        }
      </div>
    </section>

    <section class="mb-12">
      <h2 class="mb-6 flex items-center gap-2 text-2xl font-semibold">
        <span class="h-6 w-1 rounded bg-accent"></span>
        {t(locale, 'about.stack')}
      </h2>
      <div class="grid gap-6 sm:grid-cols-2">
        {
          Object.entries(techStack).map(([category, items]) => (
            <div class="card">
              <h3 class="mb-3 text-sm font-semibold uppercase tracking-wider text-ink-500">
                {category}
              </h3>
              <div class="flex flex-wrap gap-2">
                {items.map((item) => (
                  <span class="tag-chip">{item}</span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section class="mb-12">
      <h2 class="mb-6 flex items-center gap-2 text-2xl font-semibold">
        <span class="h-6 w-1 rounded bg-accent"></span>
        {t(locale, 'about.tools')}
      </h2>
      <div class="card">
        <ul class="space-y-2 text-ink-700">
          {
            aiTools[locale].map((tool) => (
              <li class="flex items-start gap-2">
                <span class="mt-1 text-accent">▸</span>
                <span>{tool}</span>
              </li>
            ))
          }
        </ul>
        <p class="mt-4 text-sm italic text-ink-500">
          {aiToolsNote[locale]}
        </p>
      </div>
    </section>

    <section class="mb-12">
      <h2 class="mb-6 flex items-center gap-2 text-2xl font-semibold">
        <span class="h-6 w-1 rounded bg-accent"></span>
        {t(locale, 'about.contact')}
      </h2>
      <div class="card space-y-3">
        {
          contacts.map((contact) => (
            <div class="flex items-center justify-between">
              <span class="text-sm text-ink-500">{contact.label}</span>
              <a
                href={contact.href}
                target={contact.href.startsWith('http') ? '_blank' : undefined}
                rel={contact.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                class="font-medium text-ink-950 transition-colors hover:text-accent"
              >
                {contact.value}
              </a>
            </div>
          ))
        }
      </div>
    </section>

    <section>
      <h2 class="mb-6 flex items-center gap-2 text-2xl font-semibold">
        <span class="h-6 w-1 rounded bg-accent"></span>
        {t(locale, 'about.philosophy')}
      </h2>
      <div class="card prose prose-lg max-w-none">
        {philosophy[locale].map((paragraph) => <p set:html={paragraph} />)}
      </div>
    </section>
  </article>
</BaseLayout>
