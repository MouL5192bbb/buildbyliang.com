---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PostCard from '~/components/PostCard.astro';
import { getCollection } from 'astro:content';
import readingTime from 'reading-time';
import { t } from '~/utils/i18n';

// 获取中文博客文章（按日期倒序，排除草稿）
const posts = (await getCollection('blog', ({ data }) => {
  return data.locale === 'zh' && !data.draft;
}))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 5);

const recentPosts = posts.map((post) => ({
  slug: post.id.replace(/\.(md|mdx)$/, ''),
  title: post.data.title,
  description: post.data.description,
  pubDate: post.data.pubDate,
  tags: post.data.tags,
  readingTime: Math.max(1, Math.round(readingTime(post.body || '').minutes)),
}));
---

<BaseLayout title={t('zh', 'site.title')} description={t('zh', 'site.description')}>
  <!-- Hero -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 pt-20 pb-16 md:pt-28 md:pb-20">
    <div class="max-w-3xl">
      <div class="inline-flex items-center gap-2 px-3 py-1 mb-6 bg-ink-100 rounded-full
                  text-xs font-medium text-ink-700">
        <span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse"></span>
        {t('zh', 'site.tagline')}
      </div>

      <h1 class="text-5xl md:text-6xl font-bold tracking-tight text-ink-950 mb-6">
        {t('zh', 'home.greeting')}
      </h1>

      <p class="text-lg md:text-xl text-ink-600 leading-relaxed mb-8 max-w-2xl">
        {t('zh', 'home.intro')}
      </p>

      <div class="flex flex-wrap gap-3">
        <a href="/blog" class="btn-primary">
          {t('zh', 'home.cta_blog')} →
        </a>
        <a href="/projects" class="btn-secondary">
          {t('zh', 'home.cta_projects')}
        </a>
      </div>
    </div>
  </section>

  <!-- 最新文章 -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 py-16 border-t border-ink-200">
    <div class="flex items-center justify-between mb-8">
      <h2 class="text-2xl font-semibold tracking-tight">{t('zh', 'home.latest_posts')}</h2>
      <a href="/blog" class="text-sm text-ink-600 hover:text-accent transition-colors">
        {t('zh', 'home.view_all')}
      </a>
    </div>

    {recentPosts.length === 0 ? (
      <div class="rounded-xl border border-dashed border-ink-300 p-12 text-center">
        <p class="text-ink-500">{t('zh', 'blog.no_posts')}</p>
        <p class="text-sm text-ink-400 mt-2">第一篇文章正在准备中...</p>
      </div>
    ) : (
      <div class="grid gap-4 md:grid-cols-2">
        {recentPosts.map((post) => (
          <PostCard
            slug={post.slug}
            title={post.title}
            description={post.description}
            pubDate={post.pubDate}
            tags={post.tags}
            readingTime={post.readingTime}
          />
        ))}
      </div>
    )}
  </section>
</BaseLayout>
