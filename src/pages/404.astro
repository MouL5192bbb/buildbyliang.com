---
import BaseLayout from '~/layouts/BaseLayout.astro';

const locale = Astro.url.pathname.startsWith('/en') ? 'en' : 'zh';
const homePath = locale === 'en' ? '/en' : '/';
const messages = {
  zh: { title: '页面找不到了', description: '你访问的页面可能已经被移除或者链接拼错了。', cta: '返回首页' },
  en: { title: 'Page not found', description: 'The page you visited may have been removed or the link is broken.', cta: 'Back to home' },
};
const m = messages[locale];
---

<BaseLayout title={m.title}>
  <section class="max-w-3xl mx-auto px-4 sm:px-6 py-32 text-center">
    <div class="text-7xl mb-6">🔍</div>
    <h1 class="text-4xl md:text-5xl font-bold tracking-tight mb-4">404</h1>
    <h2 class="text-2xl font-semibold mb-3">{m.title}</h2>
    <p class="text-ink-600 mb-8">{m.description}</p>
    <a href={homePath} class="btn-primary">{m.cta} →</a>
  </section>
</BaseLayout>
