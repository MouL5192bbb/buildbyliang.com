---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getLocaleFromUrl, t } from '~/utils/i18n';

const locale = getLocaleFromUrl(Astro.url);
const homePath = locale === 'en' ? '/en' : '/';
---

<BaseLayout title={t(locale, 'error.404_title')} description={t(locale, 'error.404_description')}>
  <section class="mx-auto max-w-3xl px-4 py-32 text-center sm:px-6">
    <div class="mb-6 text-7xl">🔍</div>
    <h1 class="mb-4 text-4xl font-bold tracking-tight md:text-5xl">404</h1>
    <h2 class="mb-3 text-2xl font-semibold">{t(locale, 'error.404_title')}</h2>
    <p class="mb-8 text-ink-600">{t(locale, 'error.404_description')}</p>
    <a href={homePath} class="btn-primary">{t(locale, 'error.404_cta')} →</a>
  </section>
</BaseLayout>
